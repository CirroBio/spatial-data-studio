// Params for the batch Xenium workflow (main.nf in this directory).
params {
    input            = null       // comma-separated list of raw Xenium bundle folders
    outdir           = 'results'
    title            = 'Xenium analysis'  // names the viewer collection and the MultiQC report

    // Preprocess & QC (recipe 01)
    min_counts       = 10         // drop cells with fewer than this many total transcripts
    min_cells        = 5          // drop genes detected in fewer than this many cells

    // Cluster (Leiden) & top marker genes (recipe 02)
    cluster_key      = 'leiden'   // obs column the clusters are written to
    resolution       = 1.0        // higher = more, smaller clusters
    marker_method    = 'wilcoxon' // DE test ranking the markers: wilcoxon | t-test | t-test_overestim_var | logreg
    n_marker_genes   = 5          // top markers per cluster shown in the dotplot

    // Neighborhood analysis (recipe 04) — niches are built from the clusters above
    n_neighborhoods  = 10         // recurring neighborhoods (niches) to find
    neighborhood_key = 'cellular_neighborhood'  // obs column the niche labels are written to

    // Also write <sample>.sdata.lowres.zarr.zip: the same session with the finest
    // pyramid level dropped from every image. The image is the bulk of a Xenium
    // checkpoint, so this carries the whole analysis at a fraction of the size and
    // renders everything but the deepest zoom.
    lowres_copy      = false

    reader_params    = null       // JSON object of extra kwargs for the io.xenium reader
    // Bookworm-slim lacks the OS libraries the image-backed read/tiling path uses; Xenium
    // bundles always carry a morphology image, so these are installed by default.
    os_packages      = 'libgl1 libglib2.0-0 libgomp1'

    backend          = "${projectDir}/../../backend"       // repo backend/ tree (cli.py + app/)
    viewer_dist      = "${projectDir}/../../frontend/dist" // built SPA (`npm ci && npm run build`)
    multiqc_container = 'quay.io/biocontainers/multiqc:1.35--pyhdfd78af_1'
}

process {
    withName: XENIUM_ANALYSIS {
        cpus   = 4
        memory = 32.GB
    }
}

profiles {
    docker {
        docker.enabled = true
    }

    // End-to-end run over the bundled raw Xenium bundle (10x "Human Lung (2 FOV)",
    // written by scripts/prepare_xenium_data.py). Combine with docker: -profile test,docker
    test {
        params.input = "${projectDir}/../../test-data/_xenium_raw/lung_2fov"
        process {
            withName: XENIUM_ANALYSIS {
                cpus   = 2
                memory = 12.GB
            }
        }
    }
}
