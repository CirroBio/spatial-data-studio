// Parameters for the spatial-data workflow (main.nf). Every parameter here is also
// described in nextflow_schema.json, and the analysis knobs below are generated from
// data_types.json's `common_params` — tests/check_catalog.py fails if the three drift.
params {
    // --- input -------------------------------------------------------------
    input                = null   // a data folder, or a .json/.yaml of "output prefix": "folder"
    data_types           = null   // comma-separated ids to look for (default: all in the catalog)
    recurse              = true   // walk into subfolders looking for datasets
    preprocess           = true   // run each data type's preprocessing recipes after loading

    // --- output ------------------------------------------------------------
    outdir               = 'results'
    title                = 'Spatial data analysis'  // names the viewer collection and the report
    lowres_max_image_mb  = 10     // image budget for the low-res copy of each checkpoint

    // --- analysis knobs (see nextflow_schema.json for which types use each) --
    min_reads_per_cell   = 10
    max_reads_per_cell   = 35000
    min_cells_per_gene   = 5
    n_top_genes          = 2000
    cluster_key          = 'leiden'
    resolution           = 1.0
    marker_method        = 'wilcoxon'
    n_marker_genes       = 5
    neighborhood_resolution = 0.1
    neighborhood_key     = 'cellular_neighborhood'

    // --- plumbing ----------------------------------------------------------
    catalog              = "${projectDir}/data_types.json"
    backend              = "${projectDir}/../backend"        // repo backend/ tree (cli.py + app/)
    // A built SPA, as either a viewer-dist.tar.gz or a directory. The workflow does not
    // build one and the repo does not carry one (frontend/dist is gitignored), so the
    // default is the archive CI attaches to each release — a run launched from a fresh
    // clone has nothing local to point at. Pass a tagged release URL instead of
    // `latest` to pin the viewer, or `${projectDir}/../frontend/dist` to use a local
    // `npm ci && npm run build`.
    viewer_dist          = 'https://github.com/CirroBio/spatial-data-studio/releases/latest/download/viewer-dist.tar.gz'
    // Both images must provide `ps` (procps). Nextflow's task wrapper runs `nxf_trace`
    // *inside* the container whenever tracing is on (-with-trace/-with-report/
    // -with-timeline), and it exits 1 outright when `ps` is missing — so an image
    // without it fails every task rather than merely losing resource metrics.
    // tests/check_containers.py asserts this for each image named here.
    analysis_container   = 'ghcr.io/astral-sh/uv:python3.11-bookworm'
    multiqc_container    = 'quay.io/biocontainers/multiqc:1.35--pyhdfd78af_1'
    // Bookworm-slim lacks the OS libraries the image-backed read/tiling path uses, and
    // every supported data type carries images. A failed install stops the task.
    os_packages          = 'libgl1 libglib2.0-0 libgomp1'
}

process {
    withName: ANALYSE {
        cpus   = 4
        memory = 32.GB
    }
}

profiles {
    docker {
        docker.enabled = true
    }

    // End-to-end run over the bundled raw Xenium bundle (10x "Human Lung (2 FOV)",
    // written by scripts/prepare_xenium_data.py). Combine with docker: -profile test,docker
    test {
        params.input = "${projectDir}/../test-data/_xenium_raw"
        process {
            withName: ANALYSE {
                cpus   = 2
                memory = 12.GB
            }
        }
    }
}
