{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // Mirrors the Vite alias: typecheck against the canvas library's sources, so a
    // build of packages/viewer isn't a prerequisite for typechecking the app.
    "paths": {
      "@cirrobio/spatial-viewer": ["../packages/viewer/src/index.ts"]
    }
  },
  "include": ["src"]
}
